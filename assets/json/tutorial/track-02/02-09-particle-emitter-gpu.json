{
  "version": "next",
  "name": "tutorial-particle-emitter-gpu",
  "sceneConfig": {
    "scene": { "background": "#0b1020" },
    "camera": {
      "fov": 55,
      "position": { "x": 0, "y": 90, "z": 220 },
      "near": 0.1,
      "far": 5000
    },
    "renderer": { "antialias": true, "ratioRate": 1 },
    "controls": {
      "enableDamping": true,
      "target": { "x": 0, "y": 35, "z": 0 }
    },
    "lights": [
      { "type": "ambient", "intensity": 0.4 },
      { "type": "directional", "intensity": 0.8, "position": { "x": 80, "y": 120, "z": 60 } }
    ],
    "renderLoop": {
      "autoResize": true,
      "firstAutoResize": true,
      "updateAnimations": true
    }
  },
  "objectList": [
    {
      "objType": "box",
      "name": "floor",
      "geometry": { "width": 320, "height": 2, "depth": 240 },
      "material": { "type": "standard", "color": "#2a3140", "roughness": 0.95 },
      "position": { "x": 0, "y": -1, "z": 0 }
    },
    {
      "objType": "particleEmitter",
      "name": "gpu-rain",
      "source": { "type": "box", "width": 200, "height": 80, "depth": 200 },
      "emission": { "mode": "continuous", "count": 6000, "rate": 900, "loop": true, "seed": 2026 },
      "particle": {
        "lifetime": 4.5,
        "velocity": { "min": { "x": -0.3, "y": -18, "z": -0.3 }, "max": { "x": 0.3, "y": -16, "z": 0.3 } },
        "opacityOverLife": [0, 0.9, 0]
      },
      "simulation": {
        "backend": "webgl-compute",
        "gravity": { "x": 0, "y": -1.5, "z": 0 },
        "boundary": { "type": "wrap", "width": 200, "height": 80, "depth": 200 },
        "compute": { "textureSize": 128 }
      },
      "position": { "x": 0, "y": 55, "z": 0 },
      "render": {
        "color": "#9ec8ff",
        "size": 2.2,
        "sizeAttenuation": true,
        "transparent": true,
        "opacity": 0.85,
        "blending": "additive",
        "depthWrite": false
      }
    },
    {
      "objType": "particleEmitter",
      "name": "cpu-sparkles",
      "source": { "type": "sphere", "radius": 60 },
      "emission": { "mode": "static", "count": 400, "seed": 99 },
      "particle": {
        "lifetime": 0,
        "sizeOverLife": [1.5, 4, 1.5],
        "opacityOverLife": [0.25, 1, 0.25]
      },
      "simulation": { "backend": "cpu", "noise": { "strength": 0.08, "frequency": 2.5 } },
      "position": { "x": -70, "y": 30, "z": 40 },
      "render": {
        "color": "#ffdd88",
        "size": 3.5,
        "transparent": true,
        "opacity": 0.85,
        "blending": "additive",
        "depthWrite": false
      }
    }
  ]
}
