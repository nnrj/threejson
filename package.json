{
  "name": "threejson",
  "version": "0.1.0-alpha.10",
  "description": "JSON-driven Three.js scene runtime: declarative 3D scenes, builders, and handlers.",
  "author": "nnrj <tianhehechu2017@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nnrj/threejson.git"
  },
  "homepage": "https://github.com/nnrj/threejson#readme",
  "bugs": {
    "url": "https://github.com/nnrj/threejson/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "exports": {
    ".": "./builtins/full.js",
    "./core": "./core/index.js",
    "./runtime": "./core/runtime.js",
    "./assets": "./core/assets.js",
    "./ai": "./core/ai/index.js",
    "./texture": "./core/texture/index.js",
    "./capabilities": "./core/capabilities/sceneCapabilityManifest.js",
    "./postprocessing-webgl": "./core/builder/postprocess/webglAdvancedPasses.js",
    "./particles-raster": "./core/builder/particle/particlesRaster.js",
    "./controls-extra": "./core/builder/controls/extraControls.js",
    "./webgpu": "./webgpu/index.js",
    "./tsl-code": "./webgpu/tslCode.js",
    "./commands": "./core/command/index.js",
    "./events": "./core/runtime/eventMechanism/resolveBindSceneEvents.js",
    "./mesh-export": "./core/handler/meshExportHandler.js",
    "./complex-mesh": "./core/builder/complexMeshCapability.js",
    "./player": "./core/player.js",
    "./resources": "./core/resources.js",
    "./runtime-config": "./core/runtimeConfig.js",
    "./scene-export": "./core/sceneExport.js",
    "./scene-payload": "./core/scenePayload.js",
    "./visual-defaults": "./core/theme/runtimeVisualDefaults.js",
    "./archive": "./core/archive/index.js",
    "./csg": "./core/handler/csgBrushOps.js",
    "./builtins": "./builtins/register.js",
    "./builtins/register": "./builtins/register.js",
    "./domains/*": "./domains/*/index.js",
    "./extensions/*": "./extensions/*",
    "./patch": "./core/handler/jsonPatchDescriptor.js",
    "./patch-core": "./core/handler/jsonPatchApplyCore.js",
    "./runtime-mutation": "./core/runtime/objectMutation/index.js",
    "./edit": "./core/edit.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "core",
    "domains",
    "builtins",
    "extensions",
    "webgpu",
    "LICENSE",
    "package.json",
    "README.md",
    "README_ZH.md"
  ],
  "sideEffects": [
    "**/core/ai/index.js",
    "**/builtins/full.js",
    "**/builtins/register.js",
    "**/domains/**/index.js",
    "**/core/builder/postprocess/webglAdvancedPasses.js",
    "**/core/builder/particle/particlesRaster.js",
    "**/core/builder/controls/extraControls.js",
    "**/core/builder/complexMeshCapability.js",
    "**/webgpu/index.js",
    "**/webgpu/tslCode.js"
  ],
  "peerDependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@tweenjs/tween.js": "^25.0.0",
    "echarts": "^5.5.0",
    "fflate": "^0.8.3",
    "gifuct-js": "^2.1.2",
    "html2canvas-pro": "^2.0.0",
    "three": ">=0.179.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.10",
    "troika-three-text": "^0.52.4"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier3d-compat": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "fflate": {
      "optional": true
    },
    "gifuct-js": {
      "optional": true
    },
    "html2canvas-pro": {
      "optional": true
    },
    "three-bvh-csg": {
      "optional": true
    },
    "three-mesh-bvh": {
      "optional": true
    },
    "troika-three-text": {
      "optional": true
    }
  },
  "scripts": {
    "generate:business-domain-manifest": "node tools/dev/build/generate-business-domain-manifest.mjs",
    "generate:subdomain": "node tools/dev/build/generate-subdomain.mjs",
    "generate:preset-manifest": "node tools/dev/build/generate-preset-manifest.mjs",
    "prepublishOnly": "npm run generate:business-domain-manifest",
    "test": "node --test tests/*.test.mjs",
    "audit:console": "node tools/dev/audit-console-usage.mjs",
    "lint:console": "node tools/dev/audit-console-usage.mjs --gate",
    "validate:demo-catalog": "node tools/dev/validate-demo-catalog.mjs",
    "verify:ai-static": "node --test tests/ai-verification.automated.mjs",
    "verify:ai-live": "node tests/ai-verification.live.mjs",
    "verify": "npm test && npm run verify:ai-static",
    "threejson-agent:gui": "python tools/threejson-agent/shell/py/gui/app.py",
    "mcp-threejson:install": "npm install --prefix tools/mcp-threejson",
    "desktop-agent:install": "npm install --prefix tools/threejson-agent-desktop",
    "build:pack": "npm pack --pack-destination=dist",
    "build:pack-assets": "npm --prefix assets run build:pack",
    "pack:all": "npm run build:pack && npm run build:pack-assets",
    "release": "node tools/dev/release/threejson-release.mjs",
    "release:check": "node tools/dev/release/threejson-release.mjs check",
    "release:version": "node tools/dev/release/threejson-release.mjs version",
    "release:test": "node tools/dev/release/threejson-release.mjs test",
    "release:pack": "node tools/dev/release/threejson-release.mjs pack",
    "release:publish": "node tools/dev/release/threejson-release.mjs publish",
    "release:tag": "node tools/dev/release/threejson-release.mjs tag",
    "release:all": "node tools/dev/release/threejson-release.mjs all"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "three.js",
    "threejson",
    "3d",
    "webgl",
    "json-scene"
  ],
  "license": "MIT",
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@threejson/assets": "file:assets",
    "@tweenjs/tween.js": "^25.0.0",
    "fflate": "^0.8.3",
    "gifuct-js": "^2.1.2",
    "html2canvas-pro": "^2.0.0",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.10",
    "troika-three-text": "^0.52.4"
  }
}
